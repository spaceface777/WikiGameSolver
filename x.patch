-STATIC inline void path_free(Path* path) {
-	Node* tmp;
-	Node* node = path->node;
-	while (node != null) {
-		tmp	 = node;
-		node = node->next;
-		string_free(&tmp->data);
-		free(tmp);
-	}
-	path->node = 0;
-}
