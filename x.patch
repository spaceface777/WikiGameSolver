-STATIC void mp_reset_df(u32 vis) {
-	for (u32 i = 0; i < vis; i++) mp_df[mp_qf[i]] = 0xFF;
-}
-
-STATIC void mp_reset_db(u32 vis) {
-	for (u32 i = 0; i < vis; i++) mp_db[mp_qb[i]] = 0xFF;
-}
